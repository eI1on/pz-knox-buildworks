# Copy to tools/paths.local.env (untracked) and point these at your machine.
# Environment variables with the same names take precedence.
# Checks that need a missing path are skipped.

PZ_GAME_DIR=C:/Program Files (x86)/Steam/steamapps/common/ProjectZomboid
PZ_MODDING_TOOLS_DIR=C:/Program Files (x86)/Steam/steamapps/common/Project Zomboid Modding Tools
PZ_DECOMPILED_SOURCE=
# Defaults to ../pz-elyonlib next to this repository.
ELYONLIB_DIR=
